# =====================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# For live deployment on cPanel / VPS (https://supa.ac.tz)
# =====================================================================

APP_NAME="SUPA SINGIDA COLLEGE"
APP_ENV=production
APP_KEY=base64:ItY43JfntbK/le3oMlWQrv/oNY2JaPPl6qeu1jOK1Ow=
APP_DEBUG=false
APP_URL=https://supa.ac.tz
FORCE_HTTPS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---------------------------------------------------------------------
# Live Database Configuration (Update with your cPanel / live DB details)
# ---------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_live_database_name
DB_USERNAME=your_live_database_user
DB_PASSWORD=your_live_database_password

# ---------------------------------------------------------------------
# Session & Cache (Uses MySQL database tables)
# ---------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@supa.ac.tz"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# Singida NMB / Mirrored Admissions Integration (Production)
# ---------------------------------------------------------------------
SINGIDA_INTEGRATION_ENABLED=true
SINGIDA_BASE_URL=https://singidattc.ac.tz
SINGIDA_API_TOKEN=dclDr8VBYK3rB9XUcqwNXhwPCzFdnQa9moMq2JyAeIhpfLZu0s6URMDTj9CY5Q1m
